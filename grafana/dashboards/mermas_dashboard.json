    {
      "id": 6,
      "type": "timeseries",
      "title": "CMV y desviación de demanda por mes",
      "description": "KPIs simulados por mes. Responde al filtro de ítems.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mermas-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
