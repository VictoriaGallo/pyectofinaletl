      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mermas-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('month', fecha)::timestamp AS time,\n       SUM(costo_merma) / NULLIF(SUM(venta_simulada), 0) * 100 AS \"CMV\",\n       SUM(desviacion_abs)::numeric / NULLIF(SUM(demanda), 0) * 100 AS \"Desviación de demanda\"\nFROM gold.merma_simulada_diaria\nWHERE $__timeFilter(fecha) AND nombre_item IN ($item)\nGROUP BY 1 ORDER BY 1"
        }
