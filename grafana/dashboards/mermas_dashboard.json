    {
      "id": 2,
      "type": "stat",
      "title": "Costo de Merma sobre Venta (CMV)",
      "description": "Costo de la merma / venta. Responde al filtro de ítems y al rango de fechas.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mermas-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mermas-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT SUM(costo_merma) / NULLIF(SUM(venta_simulada), 0) * 100 AS \"CMV\"\nFROM gold.merma_simulada_diaria WHERE $__timeFilter(fecha) AND nombre_item IN ($item)"
