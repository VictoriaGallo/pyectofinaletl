    {
      "id": 10,
      "type": "timeseries",
      "title": "Unidades vendidas por día",
      "description": "Barras: unidades del día. Línea: promedio de los últimos 7 días. Responde al filtro de ítems.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mermas-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mermas-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT fecha::timestamp AS time,\n       SUM(unidades) AS \"Unidades vendidas\",\n       AVG(SUM(unidades)) OVER (ORDER BY fecha ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS \"Media móvil 7 días\"\nFROM gold.hechos_demanda_diaria\nWHERE $__timeFilter(fecha) AND nombre_item IN ($item)\nGROUP BY fecha ORDER BY fecha"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false
          }
        },
        "overrides": [
