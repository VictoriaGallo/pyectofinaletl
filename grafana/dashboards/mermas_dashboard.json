    {
      "id": 11,
      "type": "table",
      "title": "Unidades promedio por día de la semana y franja horaria",
      "description": "Mapa de calor: promedio de unidades vendidas en cada combinación (todos los ítems, todo el periodo).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mermas-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mermas-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT franja_horaria AS \"Franja\",\n       MAX(promedio_unidades_por_dia) FILTER (WHERE dia_semana = 'Lun') AS \"Lun\",\n       MAX(promedio_unidades_por_dia) FILTER (WHERE dia_semana = 'Mar') AS \"Mar\",\n       MAX(promedio_unidades_por_dia) FILTER (WHERE dia_semana = 'Mié') AS \"Mié\",\n       MAX(promedio_unidades_por_dia) FILTER (WHERE dia_semana = 'Jue') AS \"Jue\",\n       MAX(promedio_unidades_por_dia) FILTER (WHERE dia_semana = 'Vie') AS \"Vie\",\n       MAX(promedio_unidades_por_dia) FILTER (WHERE dia_semana = 'Sáb') AS \"Sáb\",\n       MAX(promedio_unidades_por_dia) FILTER (WHERE dia_semana = 'Dom') AS \"Dom\"\nFROM gold.demanda_dia_franja\nGROUP BY franja_horaria\nORDER BY array_position(ARRAY['Morning','Afternoon','Evening','Night','Midnight'], franja_horaria)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "continuous-YlRd"
          },
          "custom": {
            "align": "center",
            "cellOptions": {
