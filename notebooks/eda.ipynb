    "    validos = benchmark[COL_FS].notna().sum()\n",
    "    print(f\"Servicio de alimentos en Colombia: {valor:,.0f} kg/persona/año \"\n",
    "          f\"(puesto {ranking:.0f} de {validos} países con dato)\")\n",
    "    region = col[\"region\"].iloc[0]\n",
    "    misma = benchmark[benchmark[\"region\"] == region]\n",
    "    print(f\"Promedio de su región ({region}): {misma[COL_FS].mean():,.1f} kg/persona/año\")\n",
    "    print(f\"Promedio mundial: {benchmark[COL_FS].mean():,.1f} kg/persona/año\")\n",
    "else:\n",
    "    print(\"Colombia no aparece en el dataset con ese nombre; revisa benchmark['pais'].unique().\")"
