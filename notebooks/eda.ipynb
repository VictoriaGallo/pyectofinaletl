    "# Coherencia: monto = precio x cantidad\n",
    "calc = ventas[\"precio_unitario\"] * ventas[\"cantidad\"]\n",
    "dif = (calc - ventas[\"monto_transaccion\"]).abs()\n",
    "incoherentes = ventas[dif > 0.01]\n",
    "print(\"Filas donde monto ≠ precio × cantidad:\", len(incoherentes))\n",
    "display(incoherentes[[\"id_orden\", \"nombre_item\", \"precio_unitario\", \"cantidad\", \"monto_transaccion\"]].head())\n",
    "\n",
    "# Valores atípicos del monto (regla del IQR)\n",
    "q1, q3 = ventas[\"monto_transaccion\"].quantile([0.25, 0.75])\n",
    "lim_sup = q3 + 1.5 * (q3 - q1)\n",
    "atipicos = ventas[ventas[\"monto_transaccion\"] > lim_sup]\n",
    "print(f\"Montos atípicos (> {lim_sup:,.0f}): {len(atipicos)}\")\n",
    "\n",
    "fig, ax = plt.subplots(1, 2, figsize=(11, 4))\n",
    "ventas[\"monto_transaccion\"].plot.hist(bins=30, ax=ax[0], title=\"Distribución del monto\")\n",
    "ventas.boxplot(column=\"monto_transaccion\", ax=ax[1])\n",
    "ax[1].set_title(\"Boxplot del monto\")\n",
    "plt.tight_layout(); plt.show()"
   ]
