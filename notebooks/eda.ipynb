       "</table>\n",
       "</div>"
      ],
      "text/plain": [
       "            filas\n",
       "fecha            \n",
       "9/99/9999     438\n",
       "99-99-9999    403\n",
       "99/99/9999    159"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "patrones = (ventas[\"fecha\"].astype(\"string\")\n",
    "            .str.replace(r\"\\d\", \"9\", regex=True)\n",
    "            .value_counts(dropna=False))\n",
    "display(patrones.to_frame(\"filas\"))"
