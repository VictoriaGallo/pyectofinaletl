    "ORDEN_FRANJA = [\"Morning\", \"Afternoon\", \"Evening\", \"Night\", \"Midnight\"]\n",
    "DIAS = [\"Lun\", \"Mar\", \"Mié\", \"Jue\", \"Vie\", \"Sáb\", \"Dom\"]\n",
    "\n",
    "presentes = set(ventas[\"franja_horaria\"].dropna())\n",
    "franjas = [f for f in ORDEN_FRANJA if f in presentes] + sorted(presentes - set(ORDEN_FRANJA))\n",
    "ventas[\"dia_semana\"] = ventas[\"fecha\"].dt.dayofweek.map(dict(enumerate(DIAS)))\n",
    "\n",
    "por_franja = (ventas.groupby(\"franja_horaria\")\n",
    "              .agg(ordenes=(\"id_orden\", \"count\"), unidades=(\"cantidad\", \"sum\"),\n",
    "                   monto=(\"monto_transaccion\", \"sum\"))\n",
    "              .reindex(franjas))\n",
    "display(por_franja)\n",
    "\n",
    "fig, ax = plt.subplots(1, 2, figsize=(11, 4))\n",
    "por_franja[\"unidades\"].plot.bar(ax=ax[0], title=\"Unidades por franja horaria\", rot=0)\n",
    "por_franja[\"monto\"].plot.bar(ax=ax[1], title=\"Monto por franja horaria\", rot=0, color=\"tab:orange\")\n",
    "plt.tight_layout(); plt.show()"
   ]
