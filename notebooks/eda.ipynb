     ]
    }
   ],
   "source": [
    "# Conversión tolerante a formatos mezclados.\n",
    "# Si en el diagnóstico ves fechas tipo 99-99-9999 con el día primero, cambia DAYFIRST a True.\n",
    "DAYFIRST = False\n",
    "\n",
    "if not pd.api.types.is_datetime64_any_dtype(ventas[\"fecha\"]):\n",
    "    ventas[\"fecha\"] = pd.to_datetime(ventas[\"fecha\"], format=\"mixed\",\n",
    "                                     dayfirst=DAYFIRST, errors=\"coerce\")\n",
    "\n",
    "sin_fecha = ventas[\"fecha\"].isna().sum()\n",
    "print(f\"Filas sin fecha válida: {sin_fecha} de {len(ventas)} ({sin_fecha/len(ventas):.1%})\")\n",
    "print(\"Rango de fechas:\", ventas[\"fecha\"].min(), \"→\", ventas[\"fecha\"].max())"
   ]
  },
